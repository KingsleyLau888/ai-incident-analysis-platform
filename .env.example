# Copy this file to .env and fill in local secrets.
# Never commit real API keys.

DATABASE_URL=sqlite:///./runtime/data/incident-live.db

# auto = system decides pipeline vs agent
# pipeline = always use stable deterministic pipeline
# agent = force ReAct Agent for debugging/demo
ANALYSIS_MODE=auto

# mock = no external LLM API
# openai_compatible = DeepSeek/OpenAI-compatible API
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Retrieval modes: tfidf, sentence-transformers, hybrid, chromadb
RETRIEVAL_MODE=tfidf
RUNBOOK_EMBEDDING_BACKEND=tfidf

# Used by demo_shop_system / demo scripts to send logs to the platform
INCIDENT_API_URL=http://127.0.0.1:8010
SHOP_DATABASE_PATH=./runtime/data/demo_shop.db

ANALYSIS_LOG_WINDOW_MINUTES=5
